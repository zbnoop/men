# encoding: utf-8
SetScriptVersion(Version="26.1.174")
import traceback
try:
    Reset()
    ClearMessages()
    template = GetTemplate(TemplateName="Fluid Flow")
    system = template.CreateSystem()
    geometry = system.GetContainer(ComponentName="Geometry")
    geometry.SetFile(FilePath="C:/Users/admin/m16_demo/m16_two_region_v2.scdocx")
    geometry.Refresh()
    model = system.GetContainer(ComponentName="Model")
    model.Refresh()
    mesh = system.GetContainer(ComponentName="Mesh")
    mesh.Refresh()
    mesh.Edit(Interactive=False)
    component = system.GetComponent(Name="Mesh")
    component.Update()
    Save(FilePath="C:/Users/admin/m16_demo/m16_coupled.wbpj", Overwrite=True)
    print("M1.6_WORKBENCH_DONE")
except Exception:
    print(traceback.format_exc())
